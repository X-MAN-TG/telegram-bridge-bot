# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Telethon StringSession of your MAIN account (generate with StringSession)
SESSION_STRING=1BVtsOHwBu...your_long_session_string...

# Your SECOND account Telegram user ID (numeric, e.g. 123456789)
# All content will be forwarded here as a private chat with yourself or this user
SECOND_ID=123456789

# Optional: your main account ID (auto-detected if empty)
# MAIN_ID=

# Turso / libSQL
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Optional: username of the exception bot (default: nubuserbot)
EXCEPTION_BOT=nubuserbot
